{
  "name": "@tooldeck/desktop",
  "version": "1.3.0",
  "private": true,
  "description": "Electron desktop app for Tooldeck.",
  "author": {
    "name": "origin-coding"
  },
  "type": "module",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "dist": "pnpm --dir ../.. builtin-plugins:stage -- --out apps/desktop/.vite/builtin-plugins && pnpm build && electron-builder",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "node --test test/scripts/readiness.test.mjs test/scripts/dev-processes.test.mjs test/scripts/boundary-imports.test.mjs && vitest run",
    "test:dev": "node --test test/scripts/readiness.test.mjs test/scripts/dev-processes.test.mjs",
    "typecheck": "nuxt prepare && tsc --noEmit -p tsconfig.desktop.json && tsc --noEmit -p .nuxt/tsconfig.node.json && vue-tsc --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.2",
    "@tdesign-vue-next/nuxt": "0.2.2",
    "@tooldeck/application-node": "workspace:*",
    "@tooldeck/hello-world": "workspace:*",
    "@tooldeck/json-tools": "workspace:*",
    "@tooldeck/protocol": "workspace:*",
    "@tooldeck/regex-tools": "workspace:*",
    "@types/node": "catalog:",
    "@unocss/nuxt": "66.9.2",
    "effect": "catalog:",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "es-toolkit": "catalog:",
    "fuse.js": "^7.4.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "tdesign-icons-vue-next": "^0.4.11",
    "tdesign-vue-next": "^1.20.7",
    "typescript": "catalog:",
    "unocss": "^66.9.2",
    "vite": "catalog:",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "io.github.origin-coding.tooldeck",
    "productName": "Tooldeck",
    "directories": {
      "output": "release"
    },
    "files": [
      ".vite/build/**",
      ".vite/renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".vite/builtin-plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "msi": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "publish": {
      "provider": "github",
      "owner": "origin-coding",
      "repo": "tooldeck"
    }
  }
}
