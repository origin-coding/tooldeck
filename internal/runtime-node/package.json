{
  "name": "@tooldeck/runtime-node-next",
  "version": "0.0.0",
  "private": true,
  "description": "Next-generation private Node runtime architecture for Tooldeck.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --configLoader runner && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tooldeck/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}
